# Backend API base URL (api-contract-spec.md §1). Copy to .env.local.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# true  -> use the in-browser mock API (no backend needed; data kept in localStorage)
# false -> call the real backend at VITE_API_BASE_URL
# If this is unset AND VITE_API_BASE_URL is unset, the mock API is used.
VITE_USE_MOCK_API=true
